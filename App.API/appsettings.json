{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppDbContextOptions": {
    "ConnectionString": "Server=tcp:YOUR-SQL.database.windows.net,1433;Initial Catalog=sqldb-orderpulse;Persist Security Info=False;User ID=YOUR_USER;Password=YOUR_PASSWORD;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "AzureStorageOptions": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_ACCOUNT_KEY;EndpointSuffix=core.windows.net",
    "ContainerName": "invoices"
  },
  "EventGridOptions": {
    "TopicEndpoint": "https://YOUR-TOPIC.REGION-1.eventgrid.azure.net/api/events",
    "TopicKey": "YOUR_TOPIC_KEY",
    "UseCloudEvents": false
  }
}
